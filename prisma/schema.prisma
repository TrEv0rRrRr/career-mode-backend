// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ENUMS

enum PreferredFoot {
  LEFT
  RIGHT
}

enum CompetitionType {
  LEAGUE
  CUP
  SUPER_CUP
  INTERNATIONAL
}

enum TransferType {
  TRANSFER
  LOAN
  FREE_AGENT
  YOUTH_PROMOTION
}

enum MatchStatus {
  SCHEDULED
  PLAYED
}

enum MatchType {
  LEAGUE
  GROUP_STAGE
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum MatchFinishType {
  REGULAR_TIME
  EXTRA_TIME
  PENALTIES
}

enum CompetitionFormat {
  LEAGUE
  KNOCKOUT
  GROUPS_AND_KNOCKOUT
  SUPER_CUP
}

enum MatchLeg {
  FIRST
  SECOND
}

// TABLAS SIN FK
model Player {
  id                Int                 @id @default(autoincrement())
  name              String              @unique
  birthDate         DateTime            @map("birth_date") @db.Date
  nationality       String
  preferredFoot     PreferredFoot       @map("preferred_foot")
  overall           Int
  height            Decimal             @db.Decimal(3, 2)
  weight            Int
  face              String?
  matchPlayerStats  MatchPlayerStats[]
  transfers         Transfer[]
  playerSeasonStats PlayerSeasonStats[]
  playerTeams       PlayerTeam[]
  playerPositions   PlayerPosition[]

  @@map("player")
}

model Manager {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  birthDate   DateTime @map("birth_date") @db.Date
  nationality String
  face        String?
  teams       Team[]

  @@map("manager")
}

model Competition {
  id                   Int                  @id @default(autoincrement())
  name                 String               @unique
  type                 CompetitionType
  format               CompetitionFormat
  logo                 String?
  hasThirdPlaceMatch   Boolean              @default(false)
  maxTeamsNumber       Int
  hasTwoLeggedKnockout Boolean              @default(false)
  groups               Int?
  teamsPerGroup        Int?
  teams                Team[]
  competitionEditions  CompetitionEdition[]

  @@map("competition")
}

model Stadium {
  id                  Int                  @id @default(autoincrement())
  name                String               @unique
  country             String
  image               String?
  capacity            Int
  openingDate         DateTime             @map("opening_date") @db.Date
  matches             Match[]
  teams               Team[]
  competitionEditions CompetitionEdition[]

  @@map("stadium")
}

model Position {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  playerPositions PlayerPosition[]

  @@map("position")
}

// TABLAS CON FK
model Match {
  id                   Int                @id @default(autoincrement())
  date                 DateTime           @db.Date
  homeGoals            Int                @default(0) @map("home_goals")
  awayGoals            Int                @default(0) @map("away_goals")
  status               MatchStatus
  stadiumId            Int                @map("stadium_id")
  matchday             Int?
  homeTeamId           Int                @map("home_team_id")
  awayTeamId           Int                @map("away_team_id")
  homePenaltyGoals     Int?               @map("home_penalty_goals")
  awayPenaltyGoals     Int?               @map("away_penalty_goals")
  leg                  MatchLeg?
  winnerTeamId         Int?               @map("winner_team_id")
  competitionEditionId Int                @map("competition_edition_id")
  type                 MatchType
  finishType           MatchFinishType?   @map("finish_type")
  matchPlayerStats     MatchPlayerStats[]

  stadium            Stadium            @relation(fields: [stadiumId], references: [id])
  competitionEdition CompetitionEdition @relation(fields: [competitionEditionId], references: [id])

  homeTeam Team @relation("HomeTeam", fields: [homeTeamId], references: [id])

  awayTeam Team @relation("AwayTeam", fields: [awayTeamId], references: [id])

  winnerTeam     Team?            @relation("WinnerTeam", fields: [winnerTeamId], references: [id])
  matchTeamStats MatchTeamStats[]

  @@map("match")
}

model Transfer {
  id         Int          @id @default(autoincrement())
  fee        Decimal      @db.Decimal(15, 2)
  date       DateTime     @db.Date
  type       TransferType
  playerId   Int          @map("player_id")
  seasonId   Int          @map("season_id")
  fromTeamId Int?         @map("from_team_id")
  toTeamId   Int          @map("to_team_id")

  player Player @relation(fields: [playerId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  fromTeam Team? @relation("FromTeam", fields: [fromTeamId], references: [id])
  toTeam   Team  @relation("ToTeam", fields: [toTeamId], references: [id])

  @@map("transfer")
}

model Season {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  notes     String?
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  careerId  Int      @map("career_id")

  career              Career               @relation(fields: [careerId], references: [id])
  transfers           Transfer[]
  teamSeasonStats     TeamSeasonStats[]
  competitionEditions CompetitionEdition[]
  playerSeasonStats   PlayerSeasonStats[]

  @@map("season")
}

model Career {
  id          Int       @id @default(autoincrement())
  managerName String    @map("manager_name")
  teamId      Int       @map("team_id")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date

  team    Team     @relation(fields: [teamId], references: [id])
  seasons Season[]

  @@map("career")
}

model Team {
  id             Int      @id @default(autoincrement())
  name           String   @unique
  shortName      String   @map("short_name")
  country        String
  logo           String?
  foundationDate DateTime @map("foundation_date") @db.Date
  primaryColor   String   @map("primary_color")
  secondaryColor String   @map("secondary_color")
  stadiumId      Int      @map("stadium_id")
  managerId      Int      @map("manager_id")
  leagueId       Int      @map("league_id")

  stadium     Stadium     @relation(fields: [stadiumId], references: [id])
  manager     Manager     @relation(fields: [managerId], references: [id])
  competition Competition @relation(fields: [leagueId], references: [id])

  homeMatches Match[] @relation("HomeTeam")

  awayMatches Match[] @relation("AwayTeam")

  winnerMatches Match[] @relation("WinnerTeam")

  incomingTransfers Transfer[] @relation("ToTeam")

  outgoingTransfers Transfer[] @relation("FromTeam")

  wonCompetitions CompetitionEdition[] @relation("CompetitionWinner")

  lostCompetitions CompetitionEdition[] @relation("CompetitionRunnerUp")

  careers           Career[]
  teamSeasonStats   TeamSeasonStats[]
  teamSeasons       CompetitionParticipant[]
  matchTeamStats    MatchTeamStats[]
  playerSeasonStats PlayerSeasonStats[]
  playerTeams       PlayerTeam[]

  @@map("team")
}

// TABLAS PUENTE
model MatchPlayerStats {
  matchId     Int     @map("match_id")
  playerId    Int     @map("player_id")
  goals       Int     @default(0)
  assists     Int     @default(0)
  rating      Decimal @default(5) @db.Decimal(3, 1)
  yellowCards Int     @default(0) @map("yellow_cards")
  redCards    Int     @default(0) @map("red_cards")

  player Player @relation(fields: [playerId], references: [id])
  match  Match  @relation(fields: [matchId], references: [id])

  @@id([matchId, playerId])
  @@map("match_player_stats")
}

model TeamSeasonStats {
  teamId   Int @map("team_id")
  seasonId Int @map("season_id")
  played   Int @default(0)
  wins     Int @default(0)
  draws    Int @default(0)
  losses   Int @default(0)
  gf       Int @default(0)
  ga       Int @default(0)
  gd       Int @default(0)

  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@id([teamId, seasonId])
  @@map("team_season_stats")
}

model CompetitionEdition {
  id             Int  @id @default(autoincrement())
  seasonId       Int  @map("season_id")
  competitionId  Int  @map("competition_id")
  winnerTeamId   Int? @map("winner_team_id")
  runnerUpTeamId Int? @map("runner_up_team_id")
  finalStadiumId Int? @map("final_stadium_id")

  season                  Season                   @relation(fields: [seasonId], references: [id])
  stadium                 Stadium?                 @relation(fields: [finalStadiumId], references: [id])
  competition             Competition              @relation(fields: [competitionId], references: [id])
  matches                 Match[]
  winnerTeam              Team?                    @relation("CompetitionWinner", fields: [winnerTeamId], references: [id])
  runnerUpTeam            Team?                    @relation("CompetitionRunnerUp", fields: [runnerUpTeamId], references: [id])
  competitionParticipants CompetitionParticipant[]

  @@unique([seasonId, competitionId])
  @@map("competition_edition")
}

model CompetitionParticipant {
  teamId               Int     @map("team_id")
  competitionEditionId Int     @map("competition_edition_id")
  points               Int?
  position             Int?
  played               Int     @default(0)
  wins                 Int     @default(0)
  draws                Int     @default(0)
  losses               Int     @default(0)
  gf                   Int     @default(0)
  ga                   Int     @default(0)
  gd                   Int     @default(0)
  group                String?

  competitionEdition CompetitionEdition @relation(fields: [competitionEditionId], references: [id])
  team               Team               @relation(fields: [teamId], references: [id])

  @@id([teamId, competitionEditionId])
  @@map("competition_participant")
}

model MatchTeamStats {
  teamId        Int @map("team_id")
  matchId       Int @map("match_id")
  possession    Int @default(0)
  shots         Int @default(0)
  shotsOnTarget Int @default(0) @map("shots_on_target")
  corners       Int @default(0)
  fouls         Int @default(0)
  offsides      Int @default(0)

  team  Team  @relation(fields: [teamId], references: [id])
  match Match @relation(fields: [matchId], references: [id])

  @@id([teamId, matchId])
  @@map("match_team_stats")
}

model PlayerSeasonStats {
  playerId    Int     @map("player_id")
  teamId      Int     @map("team_id")
  seasonId    Int     @map("season_id")
  matches     Int     @default(0)
  goals       Int     @default(0)
  assists     Int     @default(0)
  yellowCards Int     @default(0) @map("yellow_cards")
  redCards    Int     @default(0) @map("red_cards")
  rating      Decimal @db.Decimal(3, 1)

  player Player @relation(fields: [playerId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@id([playerId, teamId, seasonId])
  @@map("player_season_stats")
}

model PlayerTeam {
  id           Int       @id @default(autoincrement())
  playerId     Int       @map("player_id")
  teamId       Int       @map("team_id")
  jerseyNumber Int       @map("jersey_number")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date

  player Player @relation(fields: [playerId], references: [id])
  team   Team   @relation(fields: [teamId], references: [id])

  @@unique([playerId, teamId, startDate])
  @@map("player_team")
}

model PlayerPosition {
  playerId   Int     @map("player_id")
  positionId Int     @map("position_id")
  isPrimary  Boolean @default(false) @map("is_primary")

  player   Player   @relation(fields: [playerId], references: [id])
  position Position @relation(fields: [positionId], references: [id])

  @@id([playerId, positionId])
  @@map("player_position")
}
