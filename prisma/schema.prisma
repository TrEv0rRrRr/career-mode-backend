// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ENUMS

enum PreferredFoot {
  LEFT
  RIGHT
}

enum CompetitionType {
  LEAGUE
  CUP
  SUPER_CUP
  INTERNATIONAL
  NATIONAL_TEAMS
}

enum TransferType {
  TRANSFER
  LOAN
  FREE_AGENT
  YOUTH_PROMOTION
}

enum MatchStatus {
  SCHEDULED
  PLAYED
}

enum MatchType {
  LEAGUE
  GROUP_STAGE
  ROUND_OF_32
  ROUND_OF_16
  QUARTER_FINAL
  SEMI_FINAL
  THIRD_PLACE
  FINAL
}

enum MatchFinishType {
  REGULAR_TIME
  EXTRA_TIME
  PENALTIES
}

enum CompetitionFormat {
  LEAGUE
  KNOCKOUT
  GROUPS_AND_KNOCKOUT
  SUPER_CUP
}

enum MatchLeg {
  FIRST
  SECOND
}

enum Confederation {
  UEFA
  CONMEBOL
  CONCACAF
  AFC
  CAF
  OFC
}

// TABLAS SIN FK
model Player {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  birthDate     DateTime      @map("birth_date") @db.Date
  nationality   String
  preferredFoot PreferredFoot @map("preferred_foot")
  overall       Int
  height        Decimal       @db.Decimal(3, 2)
  weight        Int
  face          String?

  matchPlayerStats    MatchPlayerStats[]
  transfers           Transfer[]
  playerSeasonStats   PlayerSeasonStats[]
  playerClubs         PlayerClub[]
  playerPositions     PlayerPosition[]
  playerNationalTeams PlayerNationalTeam[]

  @@map("player")
}

model Manager {
  id                   Int                   @id @default(autoincrement())
  name                 String                @unique
  birthDate            DateTime              @map("birth_date") @db.Date
  nationality          String
  face                 String?
  managerClubs         ManagerClub[]
  managerNationalTeams ManagerNationalTeam[]

  @@map("manager")
}

model Competition {
  id                   Int               @id @default(autoincrement())
  name                 String            @unique
  confederation        Confederation?
  type                 CompetitionType
  format               CompetitionFormat
  logo                 String?
  hasThirdPlaceMatch   Boolean           @default(false)
  maxTeamsNumber       Int
  hasTwoLeggedKnockout Boolean           @default(false)
  groups               Int?
  teamsPerGroup        Int?

  clubs               Club[]
  competitionEditions CompetitionEdition[]

  @@map("competition")
}

model Stadium {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  country     String
  image       String?
  capacity    Int
  openingDate DateTime @map("opening_date") @db.Date

  matches             Match[]
  clubs               Club[]
  competitionEditions CompetitionEdition[]
  nationalTeams       NationalTeam[]

  @@map("stadium")
}

model Position {
  id   Int    @id @default(autoincrement())
  code String @unique
  name String

  playerPositions PlayerPosition[]

  @@map("position")
}

// TABLAS CON FK
model Match {
  id                   Int              @id @default(autoincrement())
  date                 DateTime         @db.Date
  homeGoals            Int              @default(0) @map("home_goals")
  awayGoals            Int              @default(0) @map("away_goals")
  status               MatchStatus
  stadiumId            Int              @map("stadium_id")
  matchday             Int?
  homeClubId           Int?             @map("home_club_id")
  awayClubId           Int?             @map("away_club_id")
  winnerClubId         Int?             @map("winner_club_id")
  leg                  MatchLeg?
  homePenaltyGoals     Int?             @map("home_penalty_goals")
  awayPenaltyGoals     Int?             @map("away_penalty_goals")
  tieId                Int?             @map("tie_id")
  competitionEditionId Int              @map("competition_edition_id")
  type                 MatchType
  finishType           MatchFinishType? @map("finish_type")
  homeNationalTeamId   Int?             @map("home_national_team_id")
  awayNationalTeamId   Int?             @map("away_national_team_id")
  winnerNationalTeamId Int?             @map("winner_national_team_id")

  matchPlayerStats MatchPlayerStats[]

  stadium            Stadium            @relation(fields: [stadiumId], references: [id])
  competitionEdition CompetitionEdition @relation(fields: [competitionEditionId], references: [id])

  homeClub Club? @relation("HomeClub", fields: [homeClubId], references: [id])

  awayClub Club? @relation("AwayClub", fields: [awayClubId], references: [id])

  winnerClub Club? @relation("WinnerClub", fields: [winnerClubId], references: [id])

  matchClubStats MatchClubStats[]

  tie Tie? @relation(fields: [tieId], references: [id])

  homeNationalTeam NationalTeam? @relation("HomeNationalTeam", fields: [homeNationalTeamId], references: [id])

  awayNationalTeam NationalTeam? @relation("AwayNationalTeam", fields: [awayNationalTeamId], references: [id])

  winnerNationalTeam NationalTeam? @relation("WinnerNationalTeam", fields: [winnerNationalTeamId], references: [id])

  @@unique([tieId, leg])
  @@map("match")
}

model Tie {
  id              Int @id @default(autoincrement())
  knockoutRoundId Int @map("knockout_round_id")

  knockoutRound KnockoutRound @relation(fields: [knockoutRoundId], references: [id])
  matches       Match[]

  @@map("tie")
}

model Transfer {
  id         Int          @id @default(autoincrement())
  fee        Decimal      @db.Decimal(15, 2)
  date       DateTime     @db.Date
  type       TransferType
  playerId   Int          @map("player_id")
  seasonId   Int          @map("season_id")
  fromClubId Int?         @map("from_club_id")
  toClubId   Int          @map("to_club_id")

  player Player @relation(fields: [playerId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  fromClub Club? @relation("FromClub", fields: [fromClubId], references: [id])
  toClub   Club  @relation("ToClub", fields: [toClubId], references: [id])

  @@map("transfer")
}

model Season {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  notes     String?
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  careerId  Int      @map("career_id")
  completed Boolean

  career              Career               @relation(fields: [careerId], references: [id])
  transfers           Transfer[]
  clubSeasonStats     ClubSeasonStats[]
  competitionEditions CompetitionEdition[]
  playerSeasonStats   PlayerSeasonStats[]

  @@map("season")
}

model Career {
  id          Int       @id @default(autoincrement())
  managerName String    @map("manager_name")
  clubId      Int       @map("club_id")
  startDate   DateTime  @map("start_date") @db.Date
  endDate     DateTime? @map("end_date") @db.Date

  club    Club     @relation(fields: [clubId], references: [id])
  seasons Season[]

  @@map("career")
}

model Club {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  shortName      String        @map("short_name")
  country        String
  confederation  Confederation
  logo           String?
  foundationDate DateTime      @map("foundation_date") @db.Date
  primaryColor   String        @map("primary_color")
  secondaryColor String        @map("secondary_color")
  stadiumId      Int           @map("stadium_id")
  leagueId       Int           @map("league_id")

  stadium     Stadium     @relation(fields: [stadiumId], references: [id])
  competition Competition @relation(fields: [leagueId], references: [id])

  homeMatches Match[] @relation("HomeClub")

  awayMatches Match[] @relation("AwayClub")

  winnerMatches Match[] @relation("WinnerClub")

  incomingTransfers Transfer[] @relation("ToClub")

  outgoingTransfers Transfer[] @relation("FromClub")

  wonCompetitions CompetitionEdition[] @relation("CompetitionWinner")

  lostCompetitions CompetitionEdition[] @relation("CompetitionRunnerUp")

  careers            Career[]
  clubSeasonStats    ClubSeasonStats[]
  clubSeasons        CompetitionParticipant[]
  matchClubStats     MatchClubStats[]
  playerSeasonStats  PlayerSeasonStats[]
  playerClubs        PlayerClub[]
  matchPlayerStats   MatchPlayerStats[]
  knockoutRoundClubs KnockoutRoundTeam[]
  managerClubs       ManagerClub[]

  @@map("club")
}

model NationalTeam {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  shortName      String        @map("short_name")
  logo           String?
  foundationDate DateTime      @map("foundation_date") @db.Date
  primaryColor   String        @map("primary_color")
  secondaryColor String        @map("secondary_color")
  stadiumId      Int           @map("stadium_id")
  confederation  Confederation

  stadium Stadium @relation(fields: [stadiumId], references: [id])

  homeMatches   Match[] @relation("HomeNationalTeam")
  awayMatches   Match[] @relation("AwayNationalTeam")
  winnerMatches Match[] @relation("WinnerNationalTeam")

  playerNationalTeams     PlayerNationalTeam[]
  managerNationalTeams    ManagerNationalTeam[]
  competitionParticipants NationalTeamCompetitionParticipant[]

  @@map("national_team")
}

model KnockoutRoundTeam {
  knockoutRoundId Int @map("knockout_round_id")
  clubId          Int @map("club_id")

  knockoutRound KnockoutRound @relation(fields: [knockoutRoundId], references: [id])

  club Club @relation(fields: [clubId], references: [id])

  @@id([knockoutRoundId, clubId])
  @@map("knockout_round_team")
}

model KnockoutRound {
  id                   Int       @id @default(autoincrement())
  competitionEditionId Int       @map("competition_edition_id")
  type                 MatchType
  completed            Boolean   @default(false)

  competitionEdition CompetitionEdition @relation(fields: [competitionEditionId], references: [id])

  qualifiedClubs KnockoutRoundTeam[]
  ties           Tie[]

  @@unique([competitionEditionId, type])
  @@map("knockout_round")
}

// TABLAS PUENTE
model MatchPlayerStats {
  matchId     Int     @map("match_id")
  playerId    Int     @map("player_id")
  clubId      Int     @map("club_id")
  goals       Int     @default(0)
  assists     Int     @default(0)
  rating      Decimal @default(5) @db.Decimal(3, 1)
  yellowCards Int     @default(0) @map("yellow_cards")
  redCards    Int     @default(0) @map("red_cards")

  player Player @relation(fields: [playerId], references: [id])
  match  Match  @relation(fields: [matchId], references: [id])
  club   Club   @relation(fields: [clubId], references: [id])

  @@id([matchId, playerId])
  @@map("match_player_stats")
}

model ClubSeasonStats {
  clubId   Int @map("club_id")
  seasonId Int @map("season_id")
  played   Int @default(0)
  wins     Int @default(0)
  draws    Int @default(0)
  losses   Int @default(0)
  gf       Int @default(0)
  ga       Int @default(0)
  gd       Int @default(0)

  club   Club   @relation(fields: [clubId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@id([clubId, seasonId])
  @@map("club_season_stats")
}

model CompetitionEdition {
  id             Int  @id @default(autoincrement())
  seasonId       Int  @map("season_id")
  competitionId  Int  @map("competition_id")
  winnerClubId   Int? @map("winner_club_id")
  runnerUpClubId Int? @map("runner_up_club_id")
  finalStadiumId Int? @map("final_stadium_id")

  season                   Season                               @relation(fields: [seasonId], references: [id])
  stadium                  Stadium?                             @relation(fields: [finalStadiumId], references: [id])
  competition              Competition                          @relation(fields: [competitionId], references: [id])
  matches                  Match[]
  winnerClub               Club?                                @relation("CompetitionWinner", fields: [winnerClubId], references: [id])
  runnerUpClub             Club?                                @relation("CompetitionRunnerUp", fields: [runnerUpClubId], references: [id])
  competitionParticipants  CompetitionParticipant[]
  nationalTeamParticipants NationalTeamCompetitionParticipant[]
  knockoutRounds           KnockoutRound[]

  @@unique([seasonId, competitionId])
  @@map("competition_edition")
}

model CompetitionParticipant {
  clubId               Int     @map("club_id")
  competitionEditionId Int     @map("competition_edition_id")
  points               Int?
  position             Int?
  group                String?
  played               Int     @default(0)
  wins                 Int     @default(0)
  draws                Int     @default(0)
  losses               Int     @default(0)
  gf                   Int     @default(0)
  ga                   Int     @default(0)
  gd                   Int     @default(0)

  competitionEdition CompetitionEdition @relation(fields: [competitionEditionId], references: [id])
  club               Club               @relation(fields: [clubId], references: [id])

  @@id([clubId, competitionEditionId])
  @@map("competition_participant")
}

model NationalTeamCompetitionParticipant {
  nationalTeamId       Int     @map("national_team_id")
  competitionEditionId Int     @map("competition_edition_id")
  points               Int?
  position             Int?
  group                String?
  played               Int     @default(0)
  wins                 Int     @default(0)
  draws                Int     @default(0)
  losses               Int     @default(0)
  gf                   Int     @default(0)
  ga                   Int     @default(0)
  gd                   Int     @default(0)

  competitionEdition CompetitionEdition @relation(fields: [competitionEditionId], references: [id])
  nationalTeam       NationalTeam       @relation(fields: [nationalTeamId], references: [id])

  @@id([nationalTeamId, competitionEditionId])
  @@map("national_team_competition_participant")
}

model MatchClubStats {
  clubId        Int @map("club_id")
  matchId       Int @map("match_id")
  possession    Int @default(0)
  shots         Int @default(0)
  shotsOnTarget Int @default(0) @map("shots_on_target")
  corners       Int @default(0)
  fouls         Int @default(0)
  offsides      Int @default(0)

  club  Club  @relation(fields: [clubId], references: [id])
  match Match @relation(fields: [matchId], references: [id])

  @@id([clubId, matchId])
  @@map("match_club_stats")
}

model PlayerSeasonStats {
  playerId    Int     @map("player_id")
  clubId      Int     @map("club_id")
  seasonId    Int     @map("season_id")
  matches     Int     @default(0)
  goals       Int     @default(0)
  assists     Int     @default(0)
  yellowCards Int     @default(0) @map("yellow_cards")
  redCards    Int     @default(0) @map("red_cards")
  rating      Decimal @default(5) @db.Decimal(3, 1)

  player Player @relation(fields: [playerId], references: [id])
  club   Club   @relation(fields: [clubId], references: [id])
  season Season @relation(fields: [seasonId], references: [id])

  @@id([playerId, clubId, seasonId])
  @@map("player_season_stats")
}

model PlayerClub {
  id           Int       @id @default(autoincrement())
  playerId     Int       @map("player_id")
  clubId       Int       @map("club_id")
  jerseyNumber Int       @map("jersey_number")
  startDate    DateTime  @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date

  player Player @relation(fields: [playerId], references: [id])
  club   Club   @relation(fields: [clubId], references: [id])

  @@unique([playerId, clubId, startDate])
  @@map("player_club")
}

model PlayerNationalTeam {
  id             Int       @id @default(autoincrement())
  playerId       Int       @map("player_id")
  nationalTeamId Int       @map("national_team_id")
  jerseyNumber   Int       @map("jersey_number")
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date

  player       Player       @relation(fields: [playerId], references: [id])
  nationalTeam NationalTeam @relation(fields: [nationalTeamId], references: [id])

  @@unique([playerId, nationalTeamId, startDate])
  @@map("player_national_team")
}

model PlayerPosition {
  playerId   Int     @map("player_id")
  positionId Int     @map("position_id")
  isPrimary  Boolean @default(false) @map("is_primary")

  player   Player   @relation(fields: [playerId], references: [id])
  position Position @relation(fields: [positionId], references: [id])

  @@id([playerId, positionId])
  @@map("player_position")
}

model ManagerClub {
  id        Int       @id @default(autoincrement())
  managerId Int       @map("manager_id")
  clubId    Int       @map("club_id")
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date

  manager Manager @relation(fields: [managerId], references: [id])
  club    Club    @relation(fields: [clubId], references: [id])

  @@unique([managerId, clubId, startDate])
  @@map("manager_club")
}

model ManagerNationalTeam {
  id             Int       @id @default(autoincrement())
  managerId      Int       @map("manager_id")
  nationalTeamId Int       @map("national_team_id")
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date

  manager      Manager      @relation(fields: [managerId], references: [id])
  nationalTeam NationalTeam @relation(fields: [nationalTeamId], references: [id])

  @@unique([managerId, nationalTeamId, startDate])
  @@map("manager_national_team")
}
